+// stdin and stdout must both be real terminals for the interactive TUI
+bool tty_available() {
+#if defined(_WIN32)
+    return _isatty(_fileno(stdin)) != 0 && _isatty(_fileno(stdout)) != 0;
+#else
+    return isatty(STDIN_FILENO) != 0 && isatty(STDOUT_FILENO) != 0;
