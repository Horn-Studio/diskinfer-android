+diskui::gen_params make_params() {
+    diskui::gen_params gp;
+    gp.n_ctx     = g_ui.n_ctx;
+    gp.n_predict = g_cli.n_predict;
+    gp.temp      = g_ui.temp;
+    gp.top_k     = g_cli.top_k;
+    gp.top_p     = g_cli.top_p;
+    gp.n_threads = g_cli.n_threads;
+    gp.n_ubatch  = g_cli.n_ubatch;
+    return gp;
+}
