 #include "llama-batch.h"
@@ -1662,6 +1663,33 @@ ggml_tensor * llm_graph_context::build_lora_mm(
           ggml_tensor * w,
           ggml_tensor * cur,
           ggml_tensor * w_s) const {
+    // disk streaming: the output layer is far too big to keep resident, multiply it in row chunks
+    // so only one chunk has to be read from disk at a time
+    const int chunk_rows = llama_disk::out_chunk_rows();
+    if (chunk_rows > 0 && w_s == nullptr && loras->empty() && ggml_is_contiguous(w) &&
+            ggml_nbytes(w) >= (size_t) 64 << 20 && w->ne[1] > chunk_rows && cur->ne[1] <= 8 &&
+            strcmp(ggml_get_name(w), "output.weight") == 0) {
+        const int64_t n_in  = w->ne[0];
+        const int64_t n_out = w->ne[1];
+
+        ggml_tensor * res = nullptr;
+
+        for (int64_t r0 = 0; r0 < n_out; r0 += chunk_rows) {
+            const int64_t nr = std::min<int64_t>(chunk_rows, n_out - r0);
+
+            ggml_tensor * wv   = ggml_view_2d(ctx0, w, n_in, nr, w->nb[1], (size_t) r0 * w->nb[1]);
+            ggml_tensor * part = ggml_mul_mat(ctx0, wv, cur);
+
+            if (prec_policy) {
+                prec_policy->apply(part);
+            }
+
+            res = res == nullptr ? part : ggml_concat(ctx0, res, part, 0);
+        }
+
+        return res;
+    }
+
     // a Hadamard-folded weight reads the transformed input; a LoRA delta lives in the primal basis and reads `cur`
     ggml_tensor * cur_mm = build_hadamard_input(w, cur);
     ggml_tensor * res = ggml_mul_mat(ctx0, w, cur_mm);
