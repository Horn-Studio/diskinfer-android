diff --git a/examples/diskrun/diskrun.cpp b/examples/diskrun/diskrun.cpp
new file mode 100644
index 0000000..7e724f9
--- /dev/null
+++ b/examples/diskrun/diskrun.cpp
@@ -0,0 +1,257 @@
+// minimal driver for the disk-streaming experiment: no common/ dependencies, prints RSS as it goes
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#endif
+
+#include "llama.h"
+#include "ggml-cpu.h"
+
+#include <clocale>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#if !defined(_WIN32)
+#include <unistd.h>
+#else
+#include <windows.h>
+#include <psapi.h>
+#pragma comment(lib, "psapi.lib")
+#endif
+
+static long rss_kb() {
+#if defined(_WIN32)
+    PROCESS_MEMORY_COUNTERS pmc;
+    if (!GetProcessMemoryInfo(GetCurrentProcess(), &pmc, sizeof(pmc))) {
+        return -1;
+    }
+    return (long) (pmc.WorkingSetSize / 1024);
+#else
+    FILE * f = fopen("/proc/self/statm", "r");
+    if (!f) {
+        return -1;
+    }
+    long size = 0, resident = 0;
+    if (fscanf(f, "%ld %ld", &size, &resident) != 2) {
+        fclose(f);
+        return -1;
+    }
+    fclose(f);
+    return resident * (sysconf(_SC_PAGESIZE) / 1024);
+#endif
+}
+
+static void print_rss(const char * tag) {
+    fprintf(stderr, "diskrun: rss %-22s = %ld MiB\n", tag, rss_kb() / 1024);
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+
+#if defined(_WIN32)
+    // generated pieces are raw utf-8; a legacy console code page would mangle them
+    SetConsoleOutputCP(CP_UTF8);
+#endif
+
+    std::string model_path;
+    std::string prompt     = "Hello";
+    int n_predict          = 16;
+    int n_ctx              = 128;
+    int n_batch            = 1;
+    int n_ubatch           = 1;
+    int n_threads          = 4;
+    int ngl                = 0;
+    bool extra_bufts       = true;   // repack bufts (off in disk-streaming mode)
+
+    for (int i = 1; i < argc; i++) {
+        const std::string a = argv[i];
+        auto next = [&](int def) -> int {
+            if (i + 1 < argc) {
+                return atoi(argv[++i]);
+            }
+            return def;
+        };
+        if      (a == "-m")       { if (i + 1 < argc) model_path = argv[++i]; }
+        else if (a == "-n")       { n_predict = next(n_predict); }
+        else if (a == "-c")       { n_ctx     = next(n_ctx); }
+        else if (a == "-b")       { n_batch   = next(n_batch); }
+        else if (a == "-ub")      { n_ubatch  = next(n_ubatch); }
+        else if (a == "-t")       { n_threads = next(n_threads); }
+        else if (a == "-ngl")     { ngl       = next(ngl); }
+        // native comparison on the desktop: the disk-streaming load path disables the extra
+        // (repack) buffer types, so the non-streaming baseline has to be taken with them
+        // disabled as well for a fair greedy token comparison
+        else if (a == "-no-extra-bufts" || a == "--no-extra-bufts") { extra_bufts = false; }
+        else if (a == "-p")       { if (i + 1 < argc) prompt = argv[++i]; }
+        else if (a == "--prompt-tokens") {
+            // remaining args are token ids
+            std::vector<llama_token> ids;
+            while (i + 1 < argc) {
+                ids.push_back(atoi(argv[++i]));
+            }
+            prompt.clear();
+            for (size_t k = 0; k < ids.size(); ++k) {
+                if (k) prompt += ",";
+                prompt += std::to_string(ids[k]);
+            }
+        }
+        else {
+            // bare argument: prompt words
+            if (i == 1 || a[0] != '-') {
+                prompt = a;
+                for (i++; i < argc; i++) {
+                    prompt += " ";
+                    prompt += argv[i];
+                }
+            }
+        }
+    }
+
+    if (model_path.empty()) {
+        fprintf(stderr, "usage: %s -m model.gguf [-n n_predict] [-c n_ctx] [-b n_batch] [-ub n_ubatch] [-t threads] [-ngl n_gpu_layers] [-no-extra-bufts] [prompt]\n", argv[0]);
+        return 1;
+    }
+
+    llama_backend_init();
+
+    print_rss("start");
+
+    fprintf(stderr, "diskrun: cpu features: neon = %d, dotprod = %d, matmul_int8 = %d\n",
+            ggml_cpu_has_neon(), ggml_cpu_has_dotprod(), ggml_cpu_has_matmul_int8());
+
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = ngl;
+    // The disk-streaming load path disables the extra buffer types (weight
+    // repacking: Q4_K/Q8_0 tensors get a platform-specific 8x4/16x1 layout),
+    // so the native mmap path can be run with the same layout via
+    // -no-extra-bufts for a fair greedy token comparison. The default keeps
+    // upstream behaviour (extra bufts enabled).
+    mparams.use_extra_bufts = extra_bufts;
+
+    const int64_t t_load = ggml_time_us();
+    llama_model * model = llama_model_load_from_file(model_path.c_str(), mparams);
+    if (model == nullptr) {
+        fprintf(stderr, "diskrun: failed to load model\n");
+        return 1;
+    }
+    // the loader disables the extra buffer types (weight repacking) whenever the
+    // disk-streaming path is active, so report the effective state as well
+    const char * env_stream = getenv("LLAMA_DISK_STREAM_MB");
+    const bool disk_stream_mode = env_stream == nullptr || atoi(env_stream) > 0;
+    const bool repack_active = extra_bufts && !disk_stream_mode;
+    fprintf(stderr, "diskrun: model loaded in %.1f s (extra bufts requested = %d, repack active = %d)\n",
+            (ggml_time_us() - t_load) / 1e6, extra_bufts ? 1 : 0, repack_active ? 1 : 0);
+    print_rss("after model load");
+
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    const int n_prompt = -llama_tokenize(vocab, prompt.c_str(), prompt.size(), nullptr, 0, true, true);
+    std::vector<llama_token> tokens(n_prompt);
+    if (llama_tokenize(vocab, prompt.c_str(), prompt.size(), tokens.data(), tokens.size(), true, true) < 0) {
+        fprintf(stderr, "diskrun: failed to tokenize\n");
+        return 1;
+    }
+    fprintf(stderr, "diskrun: prompt has %d tokens:", n_prompt);
+    for (auto id : tokens) {
+        fprintf(stderr, " %d", id);
+    }
+    fprintf(stderr, "\n");
+
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx     = n_ctx;
+    cparams.n_batch   = n_batch;
+    cparams.n_ubatch  = n_ubatch;
+    cparams.n_threads = n_threads;
+    cparams.n_threads_batch = n_threads;
+    cparams.no_perf   = false;
+
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    if (ctx == nullptr) {
+        fprintf(stderr, "diskrun: failed to create context\n");
+        return 1;
+    }
+    print_rss("after context");
+
+    // greedy, we only care that the thing runs
+    auto sparams = llama_sampler_chain_default_params();
+    llama_sampler * smpl = llama_sampler_chain_init(sparams);
+    llama_sampler_chain_add(smpl, llama_sampler_init_greedy());
+
+    llama_batch batch = llama_batch_init(n_batch, 0, 1);
+
+    auto decode_one = [&](llama_token id, llama_pos pos, bool logits) -> bool {
+        batch.n_tokens = 1;
+        batch.token[0]  = id;
+        batch.pos[0]    = pos;
+        batch.n_seq_id[0] = 1;
+        batch.seq_id[0][0] = 0;
+        batch.logits[0] = logits;
+        return llama_decode(ctx, batch) == 0;
+    };
+
+    int n_pos = 0;
+    const int64_t t_prefill = ggml_time_us();
+    for (int i = 0; i < n_prompt; ++i) {
+        if (!decode_one(tokens[i], n_pos++, i == n_prompt - 1)) {
+            fprintf(stderr, "diskrun: prefill failed at %d\n", i);
+            return 1;
+        }
+        fprintf(stderr, "diskrun: prefill token %d/%d done, rss = %ld MiB\n", i + 1, n_prompt, rss_kb() / 1024);
+    }
+    fprintf(stderr, "diskrun: prefill took %.1f s\n", (ggml_time_us() - t_prefill) / 1e6);
+    print_rss("after prefill");
+
+    printf("%s", prompt.c_str());
+    fflush(stdout);
+
+    const int64_t t_gen = ggml_time_us();
+    int n_gen = 0;
+
+    for (int i = 0; i < n_predict; ++i) {
+        const int64_t t0 = ggml_time_us();
+        const llama_token cur = llama_sampler_sample(smpl, ctx, -1);
+
+        if (llama_vocab_is_eog(vocab, cur)) {
+            fprintf(stderr, "diskrun: eog after %d tokens\n", n_gen);
+            break;
+        }
+
+        char buf[256];
+        const int n = llama_token_to_piece(vocab, cur, buf, sizeof(buf), 0, true);
+        if (n > 0) {
+            fwrite(buf, 1, n, stdout);
+            fflush(stdout);
+        }
+        n_gen++;
+
+        // feed the sampled token back, logits are needed for the next sample
+        if (!decode_one(cur, n_pos++, true)) {
+            fprintf(stderr, "diskrun: decode failed at %d\n", i);
+            return 1;
+        }
+
+        fprintf(stderr, "\ndiskrun: token %d id=%d sample=%.3f s, rss = %ld MiB\n",
+                n_gen, cur, (ggml_time_us() - t0) / 1e6, rss_kb() / 1024);
+    }
+
+    printf("\n");
+    fprintf(stderr, "diskrun: generated %d tokens in %.1f s (%.2f s/token)\n",
+            n_gen, (ggml_time_us() - t_gen) / 1e6, n_gen > 0 ? (ggml_time_us() - t_gen) / 1e6 / n_gen : 0.0);
+
+    llama_perf_context_print(ctx);
+
+    llama_batch_free(batch);
+    llama_sampler_free(smpl);
+    llama_free(ctx);
+    llama_model_free(model);
+
+    return 0;
+}
diff --git a/examples/diskui/CMakeLists.txt b/examples/diskui/CMakeLists.txt
new file mode 100644
index 0000000..9671631
--- /dev/null
+++ b/examples/diskui/CMakeLists.txt
@@ -0,0 +1,87 @@
+set(TARGET llama-diskui)
+
+# UI version shown in the title bar; each repo build passes its own release tag
+# (-DDISKINFER_UI_VERSION=v5 / 1.1-preview), the default is just a fallback.
+if (NOT DEFINED DISKINFER_UI_VERSION)
+    set(DISKINFER_UI_VERSION "dev")
+endif()
+
+add_executable(${TARGET}
+    diskui.cpp
+    engine.cpp
+    api.cpp
+    i18n.cpp)
+
+install(TARGETS ${TARGET} RUNTIME)
+
+target_include_directories(${TARGET} PRIVATE
+    ${CMAKE_SOURCE_DIR}/src
+    ${CMAKE_SOURCE_DIR}/vendor/cpp-httplib)
+
+target_link_libraries(${TARGET} PRIVATE
+    llama
+    ${CMAKE_THREAD_LIBS_INIT})
+
+target_compile_features(${TARGET} PRIVATE cxx_std_17)
+
+target_compile_definitions(${TARGET} PRIVATE DISKINFER_UI_VERSION="${DISKINFER_UI_VERSION}")
+
+# ---------------------------------------------------------------- HTTP / JSON
+# vendor/cpp-httplib is only added to the build when common is built; use it when
+# available and compile the implementation directly otherwise
+if (TARGET vendor::cpp-httplib)
+    target_link_libraries(${TARGET} PRIVATE vendor::cpp-httplib)
+else()
+    target_sources(${TARGET} PRIVATE ${CMAKE_SOURCE_DIR}/vendor/cpp-httplib/httplib.cpp)
+endif()
+
+if (TARGET vendor::nlohmann)
+    target_link_libraries(${TARGET} PRIVATE vendor::nlohmann)
+else()
+    target_include_directories(${TARGET} PRIVATE ${CMAKE_SOURCE_DIR}/vendor)
+endif()
+
+# keep the inline parts of httplib.h in sync with the compiled library
+target_compile_definitions(${TARGET} PRIVATE
+    CPPHTTPLIB_FORM_URL_ENCODED_PAYLOAD_MAX_LENGTH=1048576
+    CPPHTTPLIB_LISTEN_BACKLOG=512
+    CPPHTTPLIB_REQUEST_URI_MAX_LENGTH=32768
+    CPPHTTPLIB_TCP_NODELAY=1)
+
+if (WIN32 AND NOT MSVC)
+    target_link_libraries(${TARGET} PRIVATE ws2_32)
+endif()
+
+# ------------------------------------------------------------- MoE fast path
+# the MoE statistics live in src/llama-disk.h and are being extended by the
+# engine work; probe the header so the TUI still builds while it lands and picks
+# the fields up automatically once they are there
+include(CheckCXXSourceCompiles)
+if (DEFINED DISKUI_HAVE_MOE_STATS)
+    unset(DISKUI_HAVE_MOE_STATS CACHE)
+endif()
+set(CMAKE_REQUIRED_INCLUDES
+    ${CMAKE_SOURCE_DIR}/src
+    ${CMAKE_SOURCE_DIR}/include
+    ${CMAKE_SOURCE_DIR}/ggml/include)
+set(CMAKE_REQUIRED_FLAGS "${CMAKE_CXX_FLAGS}")
+check_cxx_source_compiles("
+#include \"llama-disk.h\"
+#include <type_traits>
+int main() {
+    llama_disk::llama_disk_stats * s = nullptr;
+    unsigned long long nodes   = s->moe_nodes;
+    unsigned long long experts = s->moe_experts;
+    unsigned long long bytes   = s->moe_expert_bytes;
+    int                flag    = s->moe;
+    (void) nodes; (void) experts; (void) bytes; (void) flag;
+    bool has_fn = std::is_same<decltype(llama_disk::moe_enabled()), bool>::value;
+    return has_fn ? 0 : 1;
+}
+" DISKUI_HAVE_MOE_STATS)
+if (DISKUI_HAVE_MOE_STATS)
+    message(STATUS "diskui: MoE statistics found in llama-disk.h")
+    target_compile_definitions(${TARGET} PRIVATE DISKUI_HAVE_MOE_STATS=1)
+else()
+    message(STATUS "diskui: MoE statistics not in llama-disk.h yet, MoE counters shown as 0")
+endif()
diff --git a/examples/diskui/api.cpp b/examples/diskui/api.cpp
new file mode 100644
index 0000000..0e9c3ee
--- /dev/null
+++ b/examples/diskui/api.cpp
@@ -0,0 +1,405 @@
+// api.cpp: OpenAI compatible subset on port 4000 (no authentication)
+//
+// GET  /v1/models
+// POST /v1/chat/completions   {"messages":[...], "max_tokens":N, "temperature":T, "stream":false}
+// POST /v1/completions        {"prompt":"...",  "max_tokens":N, "temperature":T, "stream":false}
+// GET  /health
+//
+// concurrency: the engine has exactly one inference slot, so a request that
+// arrives while another one (or the TUI) is decoding gets 429 immediately.
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#endif
+#include "api.h"
+
+#include "engine.h"
+#include "i18n.h"
+
+#include "httplib.h"
+
+#include <nlohmann/json.hpp>
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <ctime>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+using json = nlohmann::json;
+
+namespace diskui {
+namespace api {
+
+namespace {
+
+std::string dump_json(const json & j) {
+    return j.dump(-1, ' ', false, json::error_handler_t::replace);
+}
+
+void reply_json(httplib::Response & res, int status, const json & j) {
+    res.status = status;
+    res.set_content(dump_json(j), "application/json");
+}
+
+void reply_error(httplib::Response & res, int status, const char * type, const std::string & msg) {
+    reply_json(res, status, json{ { "error", json{ { "message", msg }, { "type", type } } } });
+}
+
+std::string random_id(const char * prefix) {
+    static std::atomic<unsigned> counter{ 0 };
+    char buf[80];
+    snprintf(buf, sizeof(buf), "%s-%08llx%04x", prefix,
+             (unsigned long long) time(nullptr), counter.fetch_add(1) & 0xffffu);
+    return buf;
+}
+
+const char * finish_reason(const std::string & f) {
+    if (f == "length") {
+        return "length";
+    }
+    return "stop";   // stop, eog and cancelled all end a normal answer
+}
+
+// the model id the API exposes: the file name (basename) of the loaded model
+std::string model_id() {
+    engine & eng = engine::get();
+    if (!eng.loaded()) {
+        return std::string();
+    }
+    return eng.basename();
+}
+
+json models_json(long long created) {
+    const std::string id = model_id();
+    json data = json::array();
+    if (!id.empty()) {
+        data.push_back(json{
+            { "id", id },
+            { "object", "model" },
+            { "created", created },
+            { "owned_by", "diskinfer" },
+        });
+    }
+    return json{ { "object", "list" }, { "data", data } };
+}
+
+bool parse_messages(const json & body, std::vector<chat_message> & out, std::string & err) {
+    if (!body.contains("messages") || !body["messages"].is_array() || body["messages"].empty()) {
+        err = "requests needs a non-empty 'messages' array";
+        return false;
+    }
+    for (const auto & m : body["messages"]) {
+        if (!m.is_object()) {
+            err = "'messages' must contain objects";
+            return false;
+        }
+        chat_message cm;
+        cm.role = m.value("role", "user");
+        if (m.contains("content") && m["content"].is_string()) {
+            cm.content = m["content"].get<std::string>();
+        } else if (m.contains("content") && m["content"].is_array()) {
+            // OpenAI content parts: keep the text parts
+            for (const auto & part : m["content"]) {
+                if (part.is_object() && part.value("type", std::string()) == "text") {
+                    cm.content += part.value("text", std::string());
+                }
+            }
+        } else {
+            err = "message 'content' must be a string (or a text-parts array)";
+            return false;
+        }
+        out.push_back(std::move(cm));
+    }
+    return true;
+}
+
+gen_params params_from(const json & body, const options & opt) {
+    gen_params gp;
+    gp.n_ctx     = opt.n_ctx;
+    gp.n_predict = body.value("max_tokens", opt.n_predict);
+    if (body.contains("temperature") && body["temperature"].is_number()) {
+        gp.temp = body["temperature"].get<float>();
+    } else {
+        gp.temp = opt.temp;
+    }
+    gp.top_k        = opt.top_k;
+    gp.top_p        = opt.top_p;
+    gp.n_threads    = opt.n_threads;
+    gp.n_ubatch     = opt.n_ubatch;
+    gp.auto_fit_ctx = true;   // the API should not fail just because ctx was set small
+    return gp;
+}
+
+struct slot_guard {
+    ~slot_guard() { engine::get().release(); }
+};
+
+} // namespace
+
+// --------------------------------------------------------------------- impl
+
+struct server::impl {
+    options            opt;
+    httplib::Server *  svr = nullptr;
+    std::thread        thread;
+    std::atomic<bool>  running{ false };
+    std::atomic<bool>  started{ false };
+    std::mutex         start_mtx;
+    std::condition_variable start_cv;
+    long long          created = 0;
+
+    void handle_models(const httplib::Request & req, httplib::Response & res) {
+        engine::get().log(i18n::trf("api.log_get_fmt", req.path.c_str(), req.remote_addr.c_str()));
+        reply_json(res, 200, models_json(created));
+    }
+
+    void handle_health(const httplib::Request &, httplib::Response & res) {
+        const std::string id = model_id();
+        reply_json(res, 200, json{
+            { "status", "ok" },
+            { "model", id },
+            { "busy", engine::get().busy() },
+            { "port", opt.port },
+        });
+    }
+
+    void handle_chat(const httplib::Request & req, httplib::Response & res) {
+        engine & eng = engine::get();
+        eng.log(i18n::trf("api.log_post_chat_fmt", req.remote_addr.c_str(), req.body.size()));
+
+        json body;
+        try {
+            body = json::parse(req.body);
+        } catch (const std::exception & e) {
+            reply_error(res, 400, "invalid_request_error", std::string("invalid JSON body: ") + e.what());
+            return;
+        }
+        if (body.value("stream", false)) {
+            reply_error(res, 400, "invalid_request_error", "stream:true is not supported, send stream:false");
+            return;
+        }
+        std::vector<chat_message> msgs;
+        std::string err;
+        if (!parse_messages(body, msgs, err)) {
+            reply_error(res, 400, "invalid_request_error", err);
+            return;
+        }
+        if (!eng.loaded()) {
+            reply_error(res, 503, "service_unavailable", "no model loaded");
+            return;
+        }
+        if (!eng.acquire(owner::api, "API /v1/chat/completions")) {
+            reply_error(res, 429, "rate_limit_error", "busy");
+            return;
+        }
+        slot_guard guard;
+
+        const gen_params gp = params_from(body, opt);
+        eng.log(i18n::trf("api.log_chat_req_fmt", msgs.size(), gp.n_predict, gp.temp));
+        const gen_result r = eng.generate_chat(msgs, gp);
+        if (!r.ok) {
+            reply_error(res, 500, "internal_error", r.error);
+            return;
+        }
+
+        json resp{
+            { "id", random_id("chatcmpl") },
+            { "object", "chat.completion" },
+            { "created", (long long) time(nullptr) },
+            { "model", model_id() },
+            { "choices", json::array({ json{
+                { "index", 0 },
+                { "message", json{ { "role", "assistant" }, { "content", r.text } } },
+                { "finish_reason", finish_reason(r.finish) },
+            } }) },
+            { "usage", json{
+                { "prompt_tokens", r.n_prompt },
+                { "completion_tokens", r.n_gen },
+                { "total_tokens", r.n_prompt + r.n_gen },
+            } },
+        };
+        reply_json(res, 200, resp);
+    }
+
+    void handle_completion(const httplib::Request & req, httplib::Response & res) {
+        engine & eng = engine::get();
+        eng.log(i18n::trf("api.log_post_comp_fmt", req.remote_addr.c_str()));
+
+        json body;
+        try {
+            body = json::parse(req.body);
+        } catch (const std::exception & e) {
+            reply_error(res, 400, "invalid_request_error", std::string("invalid JSON body: ") + e.what());
+            return;
+        }
+        if (body.value("stream", false)) {
+            reply_error(res, 400, "invalid_request_error", "stream:true is not supported, send stream:false");
+            return;
+        }
+        std::string prompt;
+        if (body.contains("prompt") && body["prompt"].is_string()) {
+            prompt = body["prompt"].get<std::string>();
+        } else if (body.contains("prompt") && body["prompt"].is_array() && !body["prompt"].empty()) {
+            for (const auto & p : body["prompt"]) {
+                if (p.is_string()) {
+                    prompt += p.get<std::string>();
+                }
+            }
+        }
+        if (prompt.empty()) {
+            reply_error(res, 400, "invalid_request_error", "requests needs a non-empty 'prompt' string");
+            return;
+        }
+        if (!eng.loaded()) {
+            reply_error(res, 503, "service_unavailable", "no model loaded");
+            return;
+        }
+        if (!eng.acquire(owner::api, "API /v1/completions")) {
+            reply_error(res, 429, "rate_limit_error", "busy");
+            return;
+        }
+        slot_guard guard;
+
+        const gen_params gp = params_from(body, opt);
+        eng.log(i18n::trf("api.log_comp_req_fmt", prompt.size(), gp.n_predict));
+        const gen_result r = eng.generate_raw(prompt, gp);
+        if (!r.ok) {
+            reply_error(res, 500, "internal_error", r.error);
+            return;
+        }
+
+        json resp{
+            { "id", random_id("cmpl") },
+            { "object", "text_completion" },
+            { "created", (long long) time(nullptr) },
+            { "model", model_id() },
+            { "choices", json::array({ json{
+                { "index", 0 },
+                { "text", r.text },
+                { "finish_reason", finish_reason(r.finish) },
+            } }) },
+            { "usage", json{
+                { "prompt_tokens", r.n_prompt },
+                { "completion_tokens", r.n_gen },
+                { "total_tokens", r.n_prompt + r.n_gen },
+            } },
+        };
+        reply_json(res, 200, resp);
+    }
+};
+
+// ------------------------------------------------------------------- server
+
+server::server() : m_impl(new impl()) {}
+
+server::~server() {
+    stop();
+    delete m_impl;
+    m_impl = nullptr;
+}
+
+bool server::start(const options & opt, std::string & err) {
+    if (m_impl->running.load()) {
+        return true;
+    }
+    impl * m = m_impl;
+    m->opt = opt;
+    m->created = (long long) time(nullptr);
+    m->svr = new httplib::Server();
+
+    m->svr->set_read_timeout(60, 0);
+    m->svr->set_write_timeout(600, 0);
+    m->svr->set_payload_max_length(64u << 20);
+    m->svr->new_task_queue = [] { return new httplib::ThreadPool(4); };
+
+    m->svr->Get("/v1/models", [m](const httplib::Request & req, httplib::Response & res) {
+        m->handle_models(req, res);
+    });
+    m->svr->Get("/health", [m](const httplib::Request & req, httplib::Response & res) {
+        m->handle_health(req, res);
+    });
+    m->svr->Post("/v1/chat/completions", [m](const httplib::Request & req, httplib::Response & res) {
+        m->handle_chat(req, res);
+    });
+    m->svr->Post("/v1/completions", [m](const httplib::Request & req, httplib::Response & res) {
+        m->handle_completion(req, res);
+    });
+
+    m->svr->set_error_handler([](const httplib::Request & req, httplib::Response & res) {
+        if (res.status == 404) {
+            reply_error(res, 404, "invalid_request_error", "unknown endpoint: " + req.method + " " + req.path);
+        }
+    });
+    m->svr->set_exception_handler([](const httplib::Request & req, httplib::Response & res, std::exception_ptr ep) {
+        std::string what = "unknown error";
+        try {
+            std::rethrow_exception(ep);
+        } catch (const std::exception & e) {
+            what = e.what();
+        } catch (...) {
+        }
+        engine::get().log(i18n::trf("api.log_exception_fmt", req.path.c_str(), what.c_str()));
+        reply_error(res, 500, "internal_error", what);
+    });
+    m->svr->set_start_handler([m] {
+        {
+            std::lock_guard<std::mutex> lk(m->start_mtx);
+            m->started.store(true);
+        }
+        m->start_cv.notify_all();
+    });
+
+    if (!m->svr->bind_to_port(opt.host, opt.port)) {
+        err = i18n::trf("api.bind_failed_fmt", opt.host.c_str(), opt.port);
+        delete m->svr;
+        m->svr = nullptr;
+        return false;
+    }
+
+    m->running.store(true);
+    m->thread = std::thread([m] {
+        m->svr->listen_after_bind();
+        m->running.store(false);
+    });
+
+    // wait until the accept loop is actually running so the first curl does not
+    // race the listener setup
+    {
+        std::unique_lock<std::mutex> lk(m->start_mtx);
+        m->start_cv.wait_for(lk, std::chrono::seconds(5), [m] { return m->started.load(); });
+    }
+
+    engine::get().log(i18n::trf("api.log_listening_fmt", opt.host.c_str(), opt.port));
+    return true;
+}
+
+void server::stop() {
+    impl * m = m_impl;
+    if (m == nullptr || m->svr == nullptr) {
+        return;
+    }
+    m->svr->stop();
+    if (m->thread.joinable()) {
+        m->thread.join();
+    }
+    delete m->svr;
+    m->svr = nullptr;
+    m->running.store(false);
+    m->started.store(false);
+}
+
+bool server::running() const {
+    return m_impl != nullptr && m_impl->running.load();
+}
+
